# Copy this file to ".env" and fill in your values.
# These are read automatically by utils/http.py (via python-dotenv if you
# load it in main.py, or exported in your shell).
#
# An NCBI API key is FREE and raises your E-utilities rate limit from
# 3 requests/sec to 10 requests/sec. Get one at:
#   https://www.ncbi.nlm.nih.gov/account/  (Settings -> API Key Management)
#
# The email is optional but polite; NCBI uses it to contact you before
# blocking if something goes wrong.

NCBI_API_KEY=
NCBI_EMAIL=you@example.org

# Optional HTTP tuning (defaults shown)
HTTP_TIMEOUT=30
HTTP_RETRIES=4
